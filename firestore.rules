rules_version = '2';

// Learning OS — Firestore security rules.
// Everything not matched below is denied by default.
//
// Collections (all taken from the client code):
//   users/{uid}/data/{key}           cloudSync.ts          private per-user sync (notes, roadmap, ...)
//   shared_*                         currentAffairsStore / channelDigestStore / sharedVideoCache
//   liveTests/{code}/...             liveTest.ts           host-run live tests (phone-number guest list)
//
// Guests are ANONYMOUS Firebase users. They are free to create, so they may
// read shared caches and take part in live tests, but must never write shared data.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function realAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ---------- private per-user data ----------
    match /users/{uid}/data/{key} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }


    function videoMarkerPath(uid, videoId) {
      return /databases/$(database)/documents/users/$(uid)/learningIntelligence/$(videoId);
    }
    function videoAggregatePath(videoId) {
      return /databases/$(database)/documents/shared_learning_video_stats/$(videoId);
    }
    function videoAggregatePaired(videoId, outcome, feedback) {
      let path = videoAggregatePath(videoId);
      let afterData = getAfter(path).data;
      let before = exists(path) ? get(path).data : null;
      return existsAfter(path)
        && afterData.sampleCount == (before == null ? 1 : before.sampleCount + 1)
        && afterData.earlyDropCount == (before == null ? 0 : before.earlyDropCount) + (outcome == 'early-drop' ? 1 : 0)
        && afterData.partialCount == (before == null ? 0 : before.partialCount) + (outcome == 'partial' ? 1 : 0)
        && afterData.nearCompleteCount == (before == null ? 0 : before.nearCompleteCount) + (outcome == 'near-complete' ? 1 : 0)
        && afterData.completedCount == (before == null ? 0 : before.completedCount) + (outcome == 'completed' ? 1 : 0)
        && afterData.positiveFeedbackCount == (before == null ? 0 : before.positiveFeedbackCount) + (feedback == 'like' ? 1 : 0)
        && afterData.negativeFeedbackCount == (before == null ? 0 : before.negativeFeedbackCount) + (feedback == 'dislike' ? 1 : 0)
        && afterData.updatedAt == request.time;
    }
    function hasNewVideoMarker(videoId) {
      let path = videoMarkerPath(request.auth.uid, videoId);
      let marker = getAfter(path).data;
      return !exists(path) && existsAfter(path)
        && marker.keys().hasAll(['outcome', 'feedback', 'submittedAt'])
        && marker.keys().hasOnly(['outcome', 'feedback', 'submittedAt'])
        && marker.outcome in ['early-drop', 'partial', 'near-complete', 'completed']
        && marker.feedback in ['like', 'dislike', 'none']
        && marker.submittedAt == request.time;
    }
    function patternMarkerPath(uid, signalId) {
      return /databases/$(database)/documents/users/$(uid)/learningPatterns/$(signalId);
    }
    function patternAggregatePath(signalId) {
      return /databases/$(database)/documents/shared_learning_patterns/$(signalId);
    }
    function patternAggregatePaired(signalId, bucket) {
      let path = patternAggregatePath(signalId);
      let afterData = getAfter(path).data;
      let before = exists(path) ? get(path).data : null;
      return existsAfter(path)
        && afterData.sampleCount == (before == null ? 1 : before.sampleCount + 1)
        && afterData.lowCount == (before == null ? 0 : before.lowCount) + (bucket == 'low' ? 1 : 0)
        && afterData.mediumCount == (before == null ? 0 : before.mediumCount) + (bucket == 'medium' ? 1 : 0)
        && afterData.highCount == (before == null ? 0 : before.highCount) + (bucket == 'high' ? 1 : 0)
        && afterData.updatedAt == request.time;
    }
    function hasNewPatternMarker(signalId) {
      let path = patternMarkerPath(request.auth.uid, signalId);
      let marker = getAfter(path).data;
      return !exists(path) && existsAfter(path)
        && marker.keys().hasAll(['bucket', 'submittedAt'])
        && marker.keys().hasOnly(['bucket', 'submittedAt'])
        && marker.bucket in ['low', 'medium', 'high']
        && marker.submittedAt == request.time;
    }

    match /users/{uid}/learningIntelligence/{videoId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if realAccount() && request.auth.uid == uid
        && videoId.size() == 11 && videoId.matches('[A-Za-z0-9_-]+')
        && request.resource.data.keys().hasAll(['outcome', 'feedback', 'submittedAt'])
        && request.resource.data.keys().hasOnly(['outcome', 'feedback', 'submittedAt'])
        && request.resource.data.outcome in ['early-drop', 'partial', 'near-complete', 'completed']
        && request.resource.data.feedback in ['like', 'dislike', 'none']
        && request.resource.data.submittedAt == request.time
        && videoAggregatePaired(videoId, request.resource.data.outcome, request.resource.data.feedback);
      allow update, delete: if false;
    }

    match /shared_learning_video_stats/{videoId} {
      allow get: if signedIn() && resource.data.sampleCount >= 10;
      allow list, delete: if false;
      allow create, update: if realAccount()
        && videoId.size() == 11 && videoId.matches('[A-Za-z0-9_-]+')
        && request.resource.data.keys().hasAll([
          'sampleCount', 'earlyDropCount', 'partialCount', 'nearCompleteCount',
          'completedCount', 'positiveFeedbackCount', 'negativeFeedbackCount', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'sampleCount', 'earlyDropCount', 'partialCount', 'nearCompleteCount',
          'completedCount', 'positiveFeedbackCount', 'negativeFeedbackCount', 'updatedAt'
        ])
        && hasNewVideoMarker(videoId)
        && videoAggregatePaired(videoId, getAfter(videoMarkerPath(request.auth.uid, videoId)).data.outcome, getAfter(videoMarkerPath(request.auth.uid, videoId)).data.feedback);
    }

    match /users/{uid}/learningPatterns/{signalId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if realAccount() && request.auth.uid == uid
        && (signalId.matches('revision_day_(1|3|7|15|30|60)')
          || signalId == 'question_mcq' || signalId == 'question_subjective')
        && request.resource.data.keys().hasAll(['bucket', 'submittedAt'])
        && request.resource.data.keys().hasOnly(['bucket', 'submittedAt'])
        && request.resource.data.bucket in ['low', 'medium', 'high']
        && request.resource.data.submittedAt == request.time
        && patternAggregatePaired(signalId, request.resource.data.bucket);
      allow update, delete: if false;
    }

    match /shared_learning_patterns/{signalId} {
      allow get: if signedIn() && resource.data.sampleCount >= 10;
      allow list, delete: if false;
      allow create, update: if realAccount()
        && (signalId.matches('revision_day_(1|3|7|15|30|60)')
          || signalId == 'question_mcq' || signalId == 'question_subjective')
        && request.resource.data.keys().hasAll(['sampleCount', 'lowCount', 'mediumCount', 'highCount', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['sampleCount', 'lowCount', 'mediumCount', 'highCount', 'updatedAt'])
        && hasNewPatternMarker(signalId)
        && patternAggregatePaired(signalId, getAfter(patternMarkerPath(request.auth.uid, signalId)).data.bucket);
    }

    // ---------- shared caches (no owner) ----------
    // Read: any signed-in user (guests too). Write: real accounts only, so an
    // anonymous account cannot poison what every student sees. No client deletes.
    match /shared_current_affairs/{id} {
      allow read: if signedIn();
      allow create, update: if realAccount();
    }
    match /shared_channel_days/{id} {
      allow read: if signedIn();
      allow create, update: if realAccount();
    }
    match /shared_video_summaries/{id} {
      allow read: if signedIn();
      allow create, update: if realAccount();
    }
    match /shared_video_analysis/{id} {
      allow read: if signedIn();
      allow create, update: if realAccount();
    }
    match /shared_topic_pools/{id} {
      allow read: if signedIn();
      allow create, update: if realAccount();
    }

    // ---------- live tests ----------
    match /liveTests/{code} {

      function sessionPath() {
        return /databases/$(database)/documents/liveTests/$(code);
      }

      function isHost() {
        return signedIn() && get(sessionPath()).data.hostUid == request.auth.uid;
      }

      // Public session doc: questions here have the answer key stripped
      // (publicQuestion in liveTest.ts); the real key lives in private/paper.
      // get only: the 6-character code is the secret, so sessions cannot be listed.
      allow get: if signedIn();
      allow create: if signedIn()
        && code.matches('[A-Z0-9]{6}')
        && request.resource.data.hostUid == request.auth.uid;
      // The host can only end the session (status/endedAt); hostUid never changes.
      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt']);

      // Answer key — host only. Students must never be able to read it.
      match /private/{docId} {
        allow read, write: if isHost();
      }

      // Host's guest list. Students may read their own entry only after their
      // player document proves ownership of that phone-number slot.
      match /allowed/{phone} {
        allow get: if isHost()
          || (signedIn()
            && exists(/databases/$(database)/documents/liveTests/$(code)/players/$(phone))
            && get(/databases/$(database)/documents/liveTests/$(code)/players/$(phone)).data.uid == request.auth.uid);
        allow list: if isHost();
        allow create, update: if isHost()
          && request.resource.data.keys().hasOnly(['phone', 'name'])
          && request.resource.data.phone == phone;
        allow delete: if isHost();
      }

      // One doc per phone number; locks that number to the first device (uid).
      // A different uid hitting the update rule gets permission-denied, which
      // joinLiveSession() turns into OTHER_DEVICE.
      match /players/{phone} {
        allow get: if isHost() || resource.data.uid == request.auth.uid;
        allow list: if isHost();

        allow create: if signedIn()
          && exists(/databases/$(database)/documents/liveTests/$(code)/allowed/$(phone))
          && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'joinedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.phone == phone;

        // Re-join (merge) or Start. startedAt can be set once, to the server
        // time, and never changed — so the personal timer cannot be reset.
        allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'joinedAt', 'startedAt'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.phone == phone
          && (resource.data.get('startedAt', null) != null
              ? request.resource.data.startedAt == resource.data.startedAt
              : (request.resource.data.get('startedAt', null) == null
                 || request.resource.data.startedAt == request.time));

        // Host frees a number locked to a lost device (resetPlayer).
        allow delete: if isHost();
      }

      // Answers. Create-only: a second write to the same phone is an update
      // and is denied, so a student cannot resubmit. Only the host reads them.
      match /submissions/{phone} {
        allow read: if isHost() || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'answers', 'timeTakenSeconds', 'submittedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.phone == phone
          && request.resource.data.timeTakenSeconds is number
          && get(/databases/$(database)/documents/liveTests/$(code)/players/$(phone)).data.uid == request.auth.uid
          && !exists(/databases/$(database)/documents/liveTests/$(code)/done/$(phone));
      }

      // "Already finished" marker. The host can read all markers; students
      // can read only their own marker. Missing markers remain readable as
      // missing so a participant can check whether they have already finished.
      match /done/{phone} {
        allow get: if isHost()
          || !exists(/databases/$(database)/documents/liveTests/$(code)/done/$(phone))
          || (signedIn() && resource.data.uid == request.auth.uid);
        allow list: if isHost();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'phone'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.phone == phone
          && get(/databases/$(database)/documents/liveTests/$(code)/players/$(phone)).data.uid == request.auth.uid;
      }
    }
  }
}
